// Virtual-key codes, shared by every input module.
namespace input;

let VK_BACK = 8; let VK_TAB = 9; let VK_RET = 13; let VK_ESC = 27;
let VK_G = 71; let VK_H = 72;
let VK_PGUP = 33; let VK_PGDN = 34; let VK_END = 35; let VK_HOME = 36;
let VK_LEFT = 37; let VK_UP = 38; let VK_RIGHT = 39; let VK_DOWN = 40;
let VK_DEL = 46; let VK_A = 65; let VK_C = 67; let VK_F = 70; let VK_N = 78;
let VK_O = 79; let VK_P = 80; let VK_S = 83; let VK_V = 86; let VK_X = 88;
let VK_Y = 89; let VK_Z = 90; let VK_COMMA = 188;
