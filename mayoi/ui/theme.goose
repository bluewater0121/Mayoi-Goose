fn same_name(a: const u8[:], b: const u8[:]) -> bool {
    if a.len != b.len { return false; }
    var i: i64 = 0;
    while i < a.len { if a[i] != b[i] { return false; } i++; }
    return true;
}

// set_named applies one of the themes of the settings menu, the way
// paletteFor picks a palette for (theme, dark).
fn set_named(n: const u8[:]) {
    if same_name(n, "matrix") { set_matrix(); return; }
    if same_name(n, "claude") { if dark { set_claude_dark(); } else { set_claude_light(); } return; }
    if same_name(n, "qoder") { if dark { set_qoder_dark(); } else { set_qoder_light(); } return; }
    if same_name(n, "grokbot") { if dark { set_grok_dark(); } else { set_grok_light(); } return; }
    if same_name(n, "cursor") { if dark { set_cursor_dark(); } else { set_cursor_light(); } return; }
    if same_name(n, "purplegold") { set_purplegold(); return; }
    if same_name(n, "pumpkin") { set_pumpkin(); return; }
    if same_name(n, "witchsbrew") { set_witchbrew(); return; }
    if same_name(n, "bloodmoon") { set_bloodmoon(); return; }
    if same_name(n, "gtavi") { set_gtavi(); return; }
    set_dark();
}
