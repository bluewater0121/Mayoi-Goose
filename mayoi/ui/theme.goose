// The look: Mayoi's palette, dark and light, and its text metrics.
namespace theme;

var pal: Pal;
var dark: bool = true;

struct Pal {
    editor: u32, chrome: u32, panel: u32, border: u32, hover: u32, active: u32,
    text: u32, muted: u32, faint: u32, accent: u32, accent_dim: u32,
    line: u32, selection: u32, selected: u32, gutter: u32, gutter_now: u32,
    status: u32, status_fg: u32, modified: u32, danger: u32,
    hit: u32, hit_now: u32, guide: u32, guide_now: u32,
    emphasis: u32, emphasis_fg: u32, surface: u32, surface_hover: u32, surface_pressed: u32,
    scrollbar: u32, shadow: u32, added: u32, changed: u32, removed: u32,
    syntax: u32[16],
}

// Syntax kinds, in the order of highlight.Kinds.
let PLAIN = 0; let KEYWORD = 1; let TYPE = 2; let FUNC = 3; let STRING = 4;
let NUMBER = 5; let COMMENT = 6; let OPERATOR = 7; let PUNCT = 8; let CONST = 9;
let BUILTIN = 10; let TAG = 11; let ATTR = 12; let VAR = 13; let HEADING = 14;
let INSERTED = 15;

fn hx(r: i32, g: i32, b: i32) -> u32 { (b as u32) << 16 | (g as u32) << 8 | r as u32 }

fn set_dark() {
    dark = true;
    var p: Pal = Pal { .. };
    p.editor = hx(0x18, 0x18, 0x1d);
    p.chrome = hx(0x13, 0x13, 0x17);
    p.panel = hx(0x15, 0x15, 0x19);
    p.border = hx(0x26, 0x26, 0x2e);
    p.hover = hx(0x1c, 0x1c, 0x22);
    p.active = hx(0x23, 0x21, 0x33);
    p.text = hx(0xd6, 0xd6, 0xde);
    p.muted = hx(0x8c, 0x8c, 0x99);
    p.faint = hx(0x66, 0x66, 0x72);
    p.accent = hx(0x8b, 0x7c, 0xf6);
    p.accent_dim = hx(0x5f, 0x57, 0xa8);
    p.line = hx(0x20, 0x20, 0x25);
    p.selection = hx(0x3a, 0x33, 0x57);
    p.selected = hx(0x3a, 0x33, 0x57);
    p.gutter = hx(0x62, 0x62, 0x6e);
    p.gutter_now = hx(0xb9, 0xb9, 0xc6);
    p.status = hx(0x13, 0x13, 0x17);
    p.status_fg = hx(0x8c, 0x8c, 0x99);
    p.modified = hx(0xe8, 0xb8, 0x6d);
    p.danger = hx(0xf0, 0x71, 0x8b);
    p.hit = hx(0x4a, 0x3f, 0x2a);
    p.hit_now = hx(0x66, 0x54, 0x30);
    p.guide = hx(0x23, 0x23, 0x28);
    p.guide_now = hx(0x3d, 0x3c, 0x44);
    p.emphasis = hx(0x72, 0x60, 0xe3);
    p.emphasis_fg = hx(0xff, 0xff, 0xff);
    p.surface = hx(0x20, 0x20, 0x27);
    p.surface_hover = hx(0x27, 0x27, 0x30);
    p.surface_pressed = hx(0x2e, 0x2e, 0x38);
    p.scrollbar = hx(0x35, 0x35, 0x3e);
    p.shadow = hx(0x0d, 0x0d, 0x10);
    p.added = hx(0x4f, 0xa8, 0x6d);
    p.changed = hx(0x5a, 0x8e, 0xe0);
    p.removed = hx(0xe0, 0x60, 0x7e);
    p.syntax[PLAIN] = p.text;
    p.syntax[KEYWORD] = hx(0xb9, 0x9c, 0xf7);
    p.syntax[TYPE] = hx(0x7d, 0xcf, 0xe0);
    p.syntax[FUNC] = hx(0x8f, 0xb4, 0xff);
    p.syntax[STRING] = hx(0xa9, 0xd4, 0x8f);
    p.syntax[NUMBER] = hx(0xf2, 0xa6, 0x79);
    p.syntax[COMMENT] = hx(0x74, 0x74, 0x81);
    p.syntax[OPERATOR] = hx(0xa0, 0xa5, 0xb8);
    p.syntax[PUNCT] = hx(0x8a, 0x8e, 0x9e);
    p.syntax[CONST] = hx(0xf2, 0xa6, 0x79);
    p.syntax[BUILTIN] = hx(0xe8, 0xc4, 0x82);
    p.syntax[TAG] = hx(0xf5, 0x90, 0xa8);
    p.syntax[ATTR] = hx(0xe8, 0xc4, 0x82);
    p.syntax[VAR] = hx(0xe2, 0xe2, 0xea);
    p.syntax[HEADING] = hx(0x8f, 0xb4, 0xff);
    p.syntax[INSERTED] = hx(0xa9, 0xd4, 0x8f);
    pal = p;
}

fn set_light() {
    dark = false;
    var p: Pal = Pal { .. };
    p.editor = hx(0xfc, 0xfc, 0xfd);
    p.chrome = hx(0xf4, 0xf4, 0xf7);
    p.panel = hx(0xf8, 0xf8, 0xfa);
