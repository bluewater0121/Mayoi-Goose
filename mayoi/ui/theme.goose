fn set_grok_dark() {
    set_dark();
    dark = true;
    pal.editor = hx(0x16, 0x16, 0x16);
    pal.chrome = hx(0xe, 0xe, 0xe);
    pal.panel = hx(0x12, 0x12, 0x12);
    pal.border = hx(0x26, 0x26, 0x26);
