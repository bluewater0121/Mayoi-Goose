    p.guide = hx(0xea, 0xea, 0xef);
    p.guide_now = hx(0xcc, 0xcc, 0xd6);
    p.emphasis = hx(0x6d, 0x5b, 0xd0);
    p.emphasis_fg = hx(0xff, 0xff, 0xff);
    p.surface = hx(0xff, 0xff, 0xff);
    p.surface_hover = hx(0xf2, 0xf2, 0xf6);
    p.surface_pressed = hx(0xea, 0xea, 0xf0);
    p.scrollbar = hx(0xc8, 0xc8, 0xd2);
    p.shadow = hx(0xd8, 0xd8, 0xe0);
    p.added = hx(0x3f, 0xa3, 0x63);
    p.changed = hx(0x4a, 0x7f, 0xd4);
    p.removed = hx(0xd6, 0x45, 0x6a);
    p.syntax[PLAIN] = p.text;
    p.syntax[KEYWORD] = hx(0x6d, 0x43, 0xc8);
    p.syntax[TYPE] = hx(0x0b, 0x73, 0x8f);
    p.syntax[FUNC] = hx(0x2b, 0x5c, 0xc4);
    p.syntax[STRING] = hx(0x37, 0x7b, 0x34);
    p.syntax[NUMBER] = hx(0xb4, 0x5b, 0x1e);
    p.syntax[COMMENT] = hx(0x8a, 0x8a, 0x96);
    p.syntax[OPERATOR] = hx(0x4a, 0x4a, 0x56);
    p.syntax[PUNCT] = hx(0x6a, 0x6a, 0x76);
    p.syntax[CONST] = hx(0xb4, 0x5b, 0x1e);
    p.syntax[BUILTIN] = hx(0x9a, 0x62, 0x12);
    p.syntax[TAG] = hx(0xc0, 0x39, 0x5c);
    p.syntax[ATTR] = hx(0x9a, 0x62, 0x12);
    p.syntax[VAR] = hx(0x1f, 0x1f, 0x28);
    p.syntax[HEADING] = hx(0x2b, 0x5c, 0xc4);
    p.syntax[INSERTED] = hx(0x37, 0x7b, 0x34);
}

fn syntax(k: i64) -> u32 { if k < 0 || k > 15 { return pal.text; } return pal.syntax[k]; }






